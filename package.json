{
  "name": "secretless-ai",
  "version": "0.23.1",
  "description": "Secretless stores API keys outside your project files and sets up AI coding tools not to read credential files. In Claude Code a hook and deny rules enforce that; Cursor, GitHub Copilot, Windsurf, Cline and Aider get instruction or ignore files that nothing enforces. A command that prints its own credential is not blocked.",
  "license": "Apache-2.0",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "secretless-ai": "dist/cli.js",
    "secretless-mcp": "dist/mcp-wrapper.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "pretest": "npm run build",
    "test": "npm run check:docs && vitest run",
    "check:docs": "node scripts/check-docs-prose.mjs",
    "typecheck": "tsc -p tsconfig.test.json",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "ai",
    "secrets",
    "credentials",
    "security",
    "claude",
    "cursor",
    "copilot",
    "windsurf",
    "cline",
    "aider",
    "mcp",
    "mcp-security",
    "mcp-secrets"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/opena2a-org/secretless-ai"
  },
  "homepage": "https://github.com/opena2a-org/secretless-ai",
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "hackmyagent": "0.32.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  },
  "optionalDependencies": {
    "@nanomind/engine": "0.1.1",
    "@nanomind/guard": "0.1.1",
    "@opena2a/aim-core": "0.2.0"
  },
  "dependencies": {
    "@noble/post-quantum": "0.6.1",
    "@opena2a/atx-verify": "0.3.0",
    "@opena2a/cli-ui": "0.4.0",
    "@opena2a/credential-patterns": "0.1.3",
    "@opena2a/telemetry": "0.1.2"
  }
}
